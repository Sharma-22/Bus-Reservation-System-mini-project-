<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GoBus | Bus Reservation</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head>
<body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">🚌 GoBus</a><div><a href="${pageContext.request.contextPath}/index.jsp">Home</a><a href="${pageContext.request.contextPath}/my-bookings">My Bookings</a></div></nav>
<header class="hero"><div class="hero-copy"><span class="eyebrow">YOUR JOURNEY, SIMPLIFIED</span><h1>Find your next<br><span>bus journey.</span></h1><p>Compare routes, choose your seat and reserve your ticket in just a few steps.</p></div><div class="search-card"><h2>Search buses</h2><p class="muted">Where would you like to go?</p>
<% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %>
<form action="${pageContext.request.contextPath}/search-buses" method="post" class="search-form"><label>From<input name="source" placeholder="e.g. Chandigarh" required></label><label>To<input name="destination" placeholder="e.g. Shimla" required></label><label>Journey date<input type="date" name="journeyDate" min="2026-10-25" value="2027-01-15" required></label><button class="btn" type="submit">Search available buses <span>→</span></button></form></div></header>
<section class="features"><div><span>01</span><h3>Easy search</h3><p>Find a route that suits your plan.</p></div><div><span>02</span><h3>Choose your seat</h3><p>Pick a seat before confirming.</p></div><div><span>03</span><h3>Quick confirmation</h3><p>Get a booking ID for your ticket.</p></div></section><footer>GoBus · AIP Mini Project · Educational demonstration</footer></body></html>
