<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,com.aip.bus.model.Bus" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Available Buses | GoBus</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">🚌 GoBus</a><div><a href="${pageContext.request.contextPath}/index.jsp">Home</a><a href="${pageContext.request.contextPath}/my-bookings">My Bookings</a></div></nav><main class="page"><span class="eyebrow">YOUR ROUTE</span><h1>Available buses</h1><p class="muted"><%=request.getAttribute("source")%> → <%=request.getAttribute("destination")%> · <%=request.getAttribute("journeyDate")%></p>
<% List<Bus> buses=(List<Bus>)request.getAttribute("buses"); if(buses==null||buses.isEmpty()){ %><div class="empty"><h2>No buses found</h2><p>Try another route or date. Sample buses are available for 15 January 2027.</p><a class="btn inline-btn" href="${pageContext.request.contextPath}/index.jsp">Search again</a></div><% }else{ for(Bus b:buses){ %><article class="bus-card"><div class="bus-main"><div class="bus-icon">🚌</div><div><h2><%=b.getBusName()%></h2><p class="muted"><%=b.getBusNumber()%> · <%=b.getJourneyDate()%></p></div></div><div class="route-times"><div><strong><%=b.getDepartureTime().toString().substring(0,5)%></strong><small><%=b.getSourceCity()%></small></div><span class="route-line">────────→</span><div><strong><%=b.getArrivalTime().toString().substring(0,5)%></strong><small><%=b.getDestinationCity()%></small></div></div><div class="fare"><small>Starting fare</small><strong>₹<%=b.getFare()%></strong><a class="btn" href="${pageContext.request.contextPath}/book?busId=<%=b.getId()%>">Select bus</a></div></article><% }} %></main><footer>GoBus · AIP Mini Project</footer></body></html>
