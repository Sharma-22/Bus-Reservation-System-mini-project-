<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="com.aip.bus.model.Bus" %><% Bus bus=(Bus)request.getAttribute("bus"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Book a Seat | GoBus</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">🚌 GoBus</a><div><a href="${pageContext.request.contextPath}/index.jsp">Home</a><a href="${pageContext.request.contextPath}/my-bookings">My Bookings</a></div></nav><main class="form-page"><div class="form-intro"><span class="eyebrow">ONE STEP AWAY</span><h1>Reserve your seat.</h1><p>Enter the passenger details below to confirm the booking.</p><% if(bus!=null){ %><div class="summary"><h3><%=bus.getBusName()%></h3><p><%=bus.getSourceCity()%> → <%=bus.getDestinationCity()%></p><p><%=bus.getJourneyDate()%> · Fare <strong>₹<%=bus.getFare()%></strong></p><p><%=bus.getTotalSeats()%> seats in this bus</p></div><% } %></div><div class="form-panel"><% if(request.getAttribute("error")!=null){ %><div class="alert error"><%=request.getAttribute("error")%></div><% } %><form action="${pageContext.request.contextPath}/book" method="post" class="stack-form"><input type="hidden" name="busId" value="<%=bus==null?"":bus.getId()%>"><label>Passenger full name<input name="name" placeholder="Enter full name" required maxlength="100"></label><label>Email address<input type="email" name="email" placeholder="you@example.com" required maxlength="120"></label><label>Phone number<input type="tel" name="phone" placeholder="Mobile number" required minlength="7" maxlength="20"></label><label>Seat number<select name="seatNumber" required><option value="">Choose a seat</option><% if(bus!=null){for(int i=1;i<=bus.getTotalSeats();i++){%><option value="<%=i%>">Seat <%=i%></option><%}}%></select></label><p class="muted tiny">The system checks whether the selected seat is already reserved.</p><button class="btn" type="submit">Confirm booking →</button></form></div></main><footer>GoBus · AIP Mini Project</footer></body></html>
