<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="java.util.List,com.aip.bus.model.Booking" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Bookings | GoBus</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">🚌 GoBus</a><div><a href="${pageContext.request.contextPath}/index.jsp">Home</a><a href="${pageContext.request.contextPath}/my-bookings">My Bookings</a></div></nav><main class="page narrow"><span class="eyebrow">YOUR TRIPS</span><h1>My bookings</h1><p class="muted">Enter the email address used when making the reservation.</p><% if(request.getAttribute("error")!=null){%><div class="alert error"><%=request.getAttribute("error")%></div><%}%><% if(request.getAttribute("message")!=null){%><div class="alert success"><%=request.getAttribute("message")%></div><%}%><form class="lookup-form" action="${pageContext.request.contextPath}/my-bookings" method="post"><input type="email" name="email" placeholder="Booking email address" value="<%=request.getAttribute("email")==null?"":request.getAttribute("email")%>" required><button class="btn" type="submit">Find bookings</button></form>
<% List<Booking> list=(List<Booking>)request.getAttribute("bookings"); if(list!=null){if(list.isEmpty()){%><div class="empty"><h2>No bookings found</h2><p>Check the email address or book a bus first.</p></div><%}else{for(Booking b:list){%><article class="booking-card"><div class="booking-heading"><div><small>BOOKING ID</small><h2>#<%=b.getId()%></h2></div><span class="status <%=b.getStatus().equals("CONFIRMED")?"confirmed":"cancelled"%>"><%=b.getStatus()%></span></div><h3><%=b.getBus().getBusName()%></h3><p><%=b.getBus().getSourceCity()%> → <%=b.getBus().getDestinationCity()%></p><div class="booking-meta"><span>Passenger: <b><%=b.getPassengerName()%></b></span><span>Seat: <b><%=b.getSeatNumber()%></b></span><span>Date: <b><%=b.getBus().getJourneyDate()%></b></span><span>Fare: <b>₹<%=b.getBus().getFare()%></b></span></div><%if(b.getStatus().equals("CONFIRMED")){%><form action="${pageContext.request.contextPath}/cancel-booking" method="post" onsubmit="return confirm('Cancel this booking?')"><input type="hidden" name="bookingId" value="<%=b.getId()%>"><input type="hidden" name="email" value="<%=b.getPassengerEmail()%>"><button class="btn btn-danger" type="submit">Cancel booking</button></form><%}%></article><%}}}%></main><footer>GoBus · AIP Mini Project</footer></body></html>
