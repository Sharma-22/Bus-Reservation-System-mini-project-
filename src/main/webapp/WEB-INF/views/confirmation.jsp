<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ page import="com.aip.bus.model.Booking" %><% Booking b=(Booking)request.getAttribute("booking"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Booking Confirmed | GoBus</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><nav class="nav"><a class="brand" href="${pageContext.request.contextPath}/index.jsp">🚌 GoBus</a><div><a href="${pageContext.request.contextPath}/index.jsp">Home</a><a href="${pageContext.request.contextPath}/my-bookings">My Bookings</a></div></nav><main class="success-page"><div class="success-icon">✓</div><span class="eyebrow">RESERVATION COMPLETE</span><h1>Your seat is reserved!</h1><p class="muted">Keep your booking ID handy. You can use your email to find this reservation later.</p><div class="ticket"><div class="ticket-top"><span>GOBUS · E-TICKET</span><strong>CONFIRMED</strong></div><div class="ticket-id">Booking ID <b>#<%=b.getId()%></b></div><h2><%=b.getBus().getBusName()%></h2><p><%=b.getBus().getSourceCity()%> <span>→</span> <%=b.getBus().getDestinationCity()%></p><div class="ticket-grid"><div><small>PASSENGER</small><strong><%=b.getPassengerName()%></strong></div><div><small>SEAT</small><strong><%=b.getSeatNumber()%></strong></div><div><small>JOURNEY DATE</small><strong><%=b.getBus().getJourneyDate()%></strong></div><div><small>FARE</small><strong>₹<%=b.getBus().getFare()%></strong></div></div><div class="ticket-bottom">Email: <%=b.getPassengerEmail()%></div></div><a class="btn inline-btn" href="${pageContext.request.contextPath}/my-bookings">View my bookings →</a><a class="text-link" href="${pageContext.request.contextPath}/index.jsp">Back to home</a></main><footer>GoBus · AIP Mini Project · Demonstration ticket, no payment collected</footer></body></html>
